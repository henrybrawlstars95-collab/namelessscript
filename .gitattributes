local function makePage(name)
    local page = Instance.new("ScrollingFrame")
    page.Name = name
    page.Size = UDim2.fromScale(1, 1)
    page.BackgroundColor3 = PANEL
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 4
    page.ScrollBarImageColor3 = PURPLE
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.Visible = false
    page.Parent = content
    Instance.new("UICorner", page).CornerRadius = UDim.new(0, 10)
    local layout = Instance.new("UIListLayout", page)
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 16)
    end)
    local pad = Instance.new("UIPadding", page)
    pad.PaddingTop = UDim.new(0, 12)
    pad.PaddingLeft = UDim.new(0, 12)
    pad.PaddingRight = UDim.new(0, 12)
    pad.PaddingBottom = UDim.new(0, 12)
    pages[name] = page
    return page
end

local function showTab(name)
    selectedTab = name
    for n, p in pairs(pages) do p.Visible = (n == name) end
    for _, b in ipairs(sidebar:GetChildren()) do
        if b:IsA("TextButton") then
            b.BackgroundColor3 = (b.Name == name) and PURPLE or PANEL
        end
    end
end

local function tabButton(name, order)
    local b = Instance.new("TextButton")
    b.Name = name
    b.Size = UDim2.new(1, -14, 0, 42)
    b.Position = UDim2.fromOffset(7, 8 + (order - 1) * 48)
    b.BackgroundColor3 = PANEL
    b.BorderSizePixel = 0
    b.Text = "   " .. name
    b.TextColor3 = TEXT
    b.TextSize = 14
    b.Font = Enum.Font.GothamMedium
    b.TextXAlignment = Enum.TextXAlignment.Left
    b.Parent = sidebar
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    b.MouseButton1Click:Connect(function() showTab(name) end)
end

