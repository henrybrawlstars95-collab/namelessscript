local function updateActivePage()
    local page = pages.Active
    if not page then return end
    for _, child in ipairs(page:GetChildren()) do
        if child:IsA("Frame") and child:GetAttribute("GeneratedActiveRow") then
            child:Destroy()
        end
    end
    local names = {}
    for name, enabled in pairs(active) do
        if enabled then table.insert(names, name) end
    end
    table.sort(names)
    if #names == 0 then
        addInfo(page, "Nenhuma função ativa", "Ative um recurso nas abas Farm ou Combat.")
    else
        for _, name in ipairs(names) do
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, -2, 0, 42)
            row.BackgroundColor3 = BG
            row.BorderSizePixel = 0
            row:SetAttribute("GeneratedActiveRow", true)
            row.Parent = page
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
            local dot = Instance.new("Frame")
            dot.Size = UDim2.fromOffset(9, 9)
            dot.Position = UDim2.fromOffset(14, 16)
            dot.BackgroundColor3 = GREEN
            dot.BorderSizePixel = 0
            dot.Parent = row
            Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
            local label = Instance.new("TextLabel")
            label.Position = UDim2.fromOffset(32, 0)
            label.Size = UDim2.new(1, -120, 1, 0)
            label.BackgroundTransparency = 1
            label.Font = Enum.Font.Gotham
            label.Text = name
            label.TextColor3 = TEXT
            label.TextSize = 13
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = row
            local off = Instance.new("TextButton")
            off.Size = UDim2.fromOffset(72, 26)
            off.Position = UDim2.new(1, -82, 0.5, -13)
            off.Text = "Desligar"
            off.Font = Enum.Font.GothamBold
            off.TextSize = 10
            off.TextColor3 = TEXT
            off.BackgroundColor3 = Color3.fromRGB(70, 35, 100)
            off.Parent = row
            Instance.new("UICorner", off).CornerRadius = UDim.new(0, 6)
            off.MouseButton1Click:Connect(function()
                active[name] = false
                if rows[name] then rows[name](false) end
                updateActivePage()
            end)
        end
    end
end

local function addToggle(page, name, description, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -2, 0, 66)
    row.BackgroundColor3 = BG
    row.BorderSizePixel = 0
    row.Parent = page
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

    local title = Instance.new("TextLabel")
    title.Position = UDim2.fromOffset(12, 8)
    title.Size = UDim2.new(1, -100, 0, 22)
    title.BackgroundTransparency = 1
    title.Font = Enum.Font.GothamBold
    title.Text = name
    title.TextColor3 = TEXT
    title.TextSize = 14
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = row

    local desc = Instance.new("TextLabel")
    desc.Position = UDim2.fromOffset(12, 32)
    desc.Size = UDim2.new(1, -100, 0, 22)
    desc.BackgroundTransparency = 1
    desc.Font = Enum.Font.Gotham
    desc.Text = description
    desc.TextColor3 = MUTED
    desc.TextSize = 11
    desc.TextXAlignment = Enum.TextXAlignment.Left
    desc.Parent = row

    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.fromOffset(48, 26)
    toggle.Position = UDim2.new(1, -62, 0.5, -13)
    toggle.Text = ""
    toggle.BackgroundColor3 = Color3.fromRGB(55, 45, 70)
    toggle.Parent = row
    Instance.new("UICorner", toggle).CornerRadius = UDim.new(1, 0)
    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(20, 20)
    knob.Position = UDim2.fromOffset(3, 3)
    knob.BackgroundColor3 = TEXT
    knob.Parent = toggle
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local enabled = false
    local function setState(value)
        enabled = value
        active[name] = value
        toggle.BackgroundColor3 = value and PURPLE or Color3.fromRGB(55, 45, 70)
        knob.Position = value and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3)
        if callback then callback(value) end
        updateActivePage()
    end
    rows[name] = setState
    toggle.MouseButton1Click:Connect(function() setState(not enabled) end)
end

